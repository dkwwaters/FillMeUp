// Copy this file to Secrets.xcconfig (same folder) and fill in what you have.
// Secrets.xcconfig is gitignored so the real values never get committed.
//
// xcconfig treats "//" as the start of a comment, which is why the proxy is
// given as a bare host name. If a secret contains "//", write it as "/$()/".

// Option 1 — development (Debug builds only). Calls the Fuel Finder API
// straight from the phone using the client ID and secret from the developer
// portal. Leave the host empty for live; set it only for test-environment keys.
FUEL_FINDER_CLIENT_ID = your-client-id
FUEL_FINDER_CLIENT_SECRET = your-client-secret
FUEL_FINDER_API_HOST =

// Option 2 — release builds. Once the proxy is deployed, set its host here
// (e.g. fill-me-up-proxy.your-account.workers.dev) and the APP_KEY you gave
// it, and delete the two credential lines above. The proxy wins if both are set.
FILL_ME_UP_API_HOST =
FILL_ME_UP_API_KEY =
